<!--
  DuelMasters.Server - the authoritative .NET backend for Duel Masters.
  Exposes JWT-authenticated REST endpoints for cards, users, and decks over
  PostgreSQL (EF Core + Npgsql). Shares DuelMasters.Domain for rules constants.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Target the current LTS (.NET 10). Domain/tests stay net8.0 (Godot pins net8.0);
         a net10.0 project may reference a net8.0 library. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DuelMasters.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\rules\DuelMasters.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the Phase 1 card catalog with the server for seeding. -->
    <Content Include="..\..\src\resources\data\cards.json" Link="cards.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
</Project>
